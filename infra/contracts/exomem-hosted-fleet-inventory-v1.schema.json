{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Artexis10/exomem/blob/main/infra/contracts/exomem-hosted-fleet-inventory-v1.schema.json",
  "title": "Exomem Hosted reconciled fleet inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "schemaVersion",
    "target",
    "status",
    "observedAt",
    "sourceSha256s",
    "counts",
    "legacyRuntimes",
    "cells",
    "issues"
  ],
  "properties": {
    "artifact": {"const": "exomem-hosted-fleet-inventory"},
    "schemaVersion": {"const": 1},
    "target": {"$ref": "#/$defs/runtime"},
    "status": {"enum": ["empty", "consistent", "inconsistent"]},
    "observedAt": {"$ref": "#/$defs/timestamp"},
    "sourceSha256s": {
      "type": "object",
      "additionalProperties": false,
      "required": ["substrate", "provisioner", "kubernetes"],
      "properties": {
        "substrate": {"$ref": "#/$defs/sha256"},
        "provisioner": {"$ref": "#/$defs/sha256"},
        "kubernetes": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "ordinaryCells",
        "reviewerCells",
        "targetCells",
        "legacyCells",
        "terminalCells",
        "inconsistentCells",
        "activeAssignments",
        "unfinishedOperations",
        "capacityClaims"
      ],
      "properties": {
        "cells": {"$ref": "#/$defs/count"},
        "ordinaryCells": {"$ref": "#/$defs/count"},
        "reviewerCells": {"$ref": "#/$defs/count"},
        "targetCells": {"$ref": "#/$defs/count"},
        "legacyCells": {"$ref": "#/$defs/count"},
        "terminalCells": {"$ref": "#/$defs/count"},
        "inconsistentCells": {"$ref": "#/$defs/count"},
        "activeAssignments": {"$ref": "#/$defs/count"},
        "unfinishedOperations": {"$ref": "#/$defs/count"},
        "capacityClaims": {"$ref": "#/$defs/count"}
      }
    },
    "legacyRuntimes": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/runtime"}
    },
    "cells": {
      "type": "array",
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/cell"}
    },
    "issues": {"$ref": "#/$defs/codeList"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseVersion",
        "runtimeImage",
        "protocolVersion",
        "agentProfile",
        "gatewayContractDigest",
        "commandFingerprint",
        "schemaDigest",
        "compatibilityDigest"
      ],
      "properties": {
        "releaseVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "runtimeImage": {
          "type": "string",
          "pattern": "^ghcr\\.io/artexis10/exomem@sha256:[0-9a-f]{64}$"
        },
        "protocolVersion": {"type": "string", "pattern": "^[1-9][0-9]{0,7}$"},
        "agentProfile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "gatewayContractDigest": {"$ref": "#/$defs/sha256"},
        "commandFingerprint": {"$ref": "#/$defs/sha256"},
        "schemaDigest": {"$ref": "#/$defs/sha256"},
        "compatibilityDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "codeList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    },
    "idList": {
      "type": "array",
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/opaqueId"}
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingStatus",
        "routable",
        "capacityClaim",
        "desiredState",
        "namespace",
        "helmRelease",
        "workload",
        "volume",
        "reviewerAuthority",
        "reviewerPurpose",
        "assignmentIds",
        "unfinishedOperationIds"
      ],
      "properties": {
        "bindingStatus": {"type": ["string", "null"], "enum": ["active", "destroyed", null]},
        "routable": {"type": "boolean"},
        "capacityClaim": {"type": "boolean"},
        "desiredState": {"type": "boolean"},
        "namespace": {"type": "boolean"},
        "helmRelease": {"type": "boolean"},
        "workload": {"type": "boolean"},
        "volume": {"type": "boolean"},
        "reviewerAuthority": {"type": "boolean"},
        "reviewerPurpose": {"type": "boolean"},
        "assignmentIds": {"$ref": "#/$defs/idList"},
        "unfinishedOperationIds": {"$ref": "#/$defs/idList"}
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cellId", "classification", "runtime", "surfaces", "issues"],
      "properties": {
        "cellId": {"$ref": "#/$defs/opaqueId"},
        "classification": {
          "enum": ["target", "legacy", "reviewer", "terminal", "inconsistent"]
        },
        "runtime": {
          "anyOf": [{"$ref": "#/$defs/runtime"}, {"type": "null"}]
        },
        "surfaces": {"$ref": "#/$defs/surfaces"},
        "issues": {"$ref": "#/$defs/codeList"}
      }
    }
  }
}
