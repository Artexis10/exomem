# K3s agent (add-cloud-node-provisioning N4). Joins over the private network
# with the dedicated agent token; carries nothing a server needs.
server: {{ ("https://" ~ k3s_server_private_ip ~ ":6443") | to_json }}
token: {{ k3s_agent_join_token | to_json }}
node-name: {{ inventory_hostname | to_json }}
node-ip: {{ private_node_ip | to_json }}
flannel-iface: {{ k3s_resolved_private_interface | to_json }}
node-label:
  - {{ k3s_agent_node_label | to_json }}
{% if inventory_hostname in (groups['dedicated_hosts'] | default([])) %}
  # Not a Hetzner Cloud server: the hcloud CSI node plugin's affinity skips it.
  - "instance.hetzner.cloud/provided-by=robot"
{% endif %}
{% if k3s_agent_dedicated_cell %}
  - {{ ("exomem.io/dedicated-cell=" ~ k3s_agent_dedicated_cell) | to_json }}
{% endif %}
{% if k3s_agent_shared_profile %}
  - {{ ("exomem.io/shared-profile=" ~ k3s_agent_shared_profile) | to_json }}
{% endif %}
{% if k3s_agent_dedicated_cell or k3s_agent_shared_profile %}
node-taint:
{% endif %}
{% if k3s_agent_dedicated_cell %}
  - {{ ("exomem.io/dedicated-cell=" ~ k3s_agent_dedicated_cell ~ ":NoSchedule") | to_json }}
{% endif %}
{% if k3s_agent_shared_profile %}
  - {{ ("exomem.io/shared-profile=" ~ k3s_agent_shared_profile ~ ":NoSchedule") | to_json }}
{% endif %}
protect-kernel-defaults: true
kubelet-arg:
{% for argument in k3s_kubelet_args %}
  - {{ argument | to_json }}
{% endfor %}
