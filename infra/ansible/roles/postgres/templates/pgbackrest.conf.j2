## Managed by Ansible (role: postgres).
[global]
repo1-type={{ postgres_pgbackrest_repo_type }}
repo1-s3-endpoint={{ postgres_pgbackrest_s3_endpoint }}
repo1-s3-region={{ postgres_pgbackrest_s3_region }}
repo1-s3-bucket={{ postgres_pgbackrest_s3_bucket }}
repo1-s3-key={{ postgres_pgbackrest_s3_key }}
repo1-s3-key-secret={{ postgres_pgbackrest_s3_key_secret }}
repo1-s3-uri-style=path
repo1-path=/{{ postgres_pgbackrest_s3_key_prefix }}
repo1-retention-full={{ postgres_pgbackrest_full_retention }}
repo1-retention-full-type=count
## Client-side encryption: B2's server-side encryption protects the object
## store from B2 itself, not from anything with read access to the bucket
## (an overbroad key, a misconfigured public-listing, B2 itself under
## compulsion). pgBackRest 2.59 supports exactly two repo-cipher-type
## values -- "none" and "aes-256-cbc" (checked directly with `pgbackrest
## help backup repo-cipher-type`; there is no aes-256-gcm to prefer). Without
## this, `pgbackrest info` reports cipher: none and backup.info, WAL and
## every backup file are plain-gzip in the bucket.
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass={{ postgres_pgbackrest_repo_cipher_pass }}
{% if not postgres_pgbackrest_s3_verify_tls %}
repo1-storage-verify-tls=n
{% endif %}
process-max=2
log-level-console=info
log-level-file=detail
start-fast=y

[{{ postgres_pgbackrest_stanza }}]
pg1-path={{ postgres_data_dir }}
pg1-port=5432
pg1-socket-path=/var/run/postgresql
