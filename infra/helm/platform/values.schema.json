{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["provisioner", "admission", "scheduler", "observability", "capacityCollector", "durability"],
  "properties": {
    "runtime": false,
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "originHostname", "replicas", "maxInflight", "databaseSecretName", "databaseSecretKey", "controlPlaneKeySecretName", "controlPlaneKeySecretKey", "databaseEgressCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "originHostname": {"type": "string"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2},
        "maxInflight": {"type": "integer", "minimum": 1, "maximum": 32},
        "databaseSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "controlPlaneKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "controlPlaneKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "databaseEgressCidrs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "image": {"pattern": "^ghcr\\.io/substrate-systems/substrate-gateway@sha256:[a-f0-9]{64}$"},
        "originHostname": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "databaseEgressCidrs": {"minItems": 1}
      }}
    },
    "provisioner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentLockJson", "deploymentLockSha256", "runtimeSelection", "replicas", "databaseSchema", "databaseRole", "trustedProxyIps", "cellChartPath", "cellChartVersion", "helmBinary", "helmVersion", "controlHostname", "transferHostname", "browserOrigin", "location", "internalOrigin", "pollSeconds", "idlePollSeconds", "providerRecoveryPublicKeySecret", "providerRecoverySigningKeySecret", "capacityReceiptPublicKeySecret"],
      "properties": {
        "deploymentLockJson": {"type": "string", "minLength": 1, "maxLength": 1048576, "contentMediaType": "application/json"},
        "deploymentLockSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtimeSelection": {"enum": ["", "active", "rollback"]},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2},
        "databaseSchema": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$"},
        "databaseRole": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,62}$"},
        "trustedProxyIps": {"type": "string", "minLength": 1},
        "cellChartPath": {"type": "string", "pattern": "^/[^\\s]+$"},
        "cellChartVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "helmBinary": {"type": "string", "pattern": "^/[^\\s]+$"},
        "helmVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "controlHostname": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "transferHostname": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "browserOrigin": {"type": "string", "pattern": "^https://[^/]+$"},
        "location": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"},
        "internalOrigin": {"type": "string", "pattern": "^https?://\\{resource\\}\\.\\{namespace\\}\\.svc\\.cluster\\.local:[0-9]{2,5}$"},
        "pollSeconds": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "idlePollSeconds": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "providerRecoveryPublicKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "providerRecoverySigningKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "capacityReceiptPublicKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"const": "exomem-capacity-receipt-verifier"},
            "key": {"const": "public-key"}
          }
        }
      }
    },
    "admission": {
      "type": "object",
      "required": ["namespaceContractOperatorUsernames"],
      "properties": {
        "namespaceContractOperatorUsernames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "scheduler": {
      "type": "object",
      "required": ["contractVersion", "contractSha256", "secretName", "secretKey"],
      "properties": {
        "contractVersion": {"const": 1},
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "observability": {
      "type": "object",
      "required": ["contractSha256", "alertDeliverySecretName", "alertDeliverySecretKey"],
      "properties": {
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "alertDeliverySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "alertDeliverySecretKey": {"type": "string", "minLength": 1}
      }
    },
    "capacityCollector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "contractSha256", "hcloudServerId", "stateConfigMap", "privateKeySecret", "hcloudTokenSecret"],
      "properties": {
        "schedule": {"const": "*/5 * * * *"},
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "hcloudServerId": {"type": "integer", "minimum": 1},
        "stateConfigMap": {"const": "exomem-capacity-receipt"},
        "privateKeySecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"const": "exomem-capacity-receipt-signer"},
            "key": {"const": "private-key"}
          }
        },
        "hcloudTokenSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"const": "exomem-hcloud-capacity-reader"},
            "key": {"const": "token"}
          }
        }
      }
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractSha256", "storageContractSha256", "b2Endpoint", "b2Region", "recoveryBucket", "userExportBucket", "databaseBackupBucket", "databaseBackup"],
      "properties": {
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "storageContractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "b2Endpoint": {"type": "string", "pattern": "^https://[^/]+$"},
        "b2Region": {"type": "string", "pattern": "^[a-z0-9-]{2,64}$"},
        "recoveryBucket": {"type": "string", "pattern": "^[a-z0-9-]{6,63}$"},
        "userExportBucket": {"type": "string", "pattern": "^[a-z0-9-]{6,63}$"},
        "databaseBackupBucket": {"type": "string", "pattern": "^[a-z0-9-]{6,63}$"},
        "databaseBackup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proofTenantId", "proofCellId", "sourceService", "maintenanceService", "scratchService", "scratchDatabase", "expectedRestoreOwner", "verificationSql"],
          "properties": {
            "proofTenantId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,256}$"},
            "proofCellId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,256}$"},
            "sourceService": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "maintenanceService": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "scratchService": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
            "scratchDatabase": {"type": "string", "pattern": "^[a-zA-Z0-9_]{1,63}$"},
            "expectedRestoreOwner": {"type": "string", "pattern": "^[a-zA-Z0-9_]{1,63}$"},
            "verificationSql": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        }
      }
    },
    "cellctl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "cellImageRepository", "namespace", "replicas", "b2BucketName", "b2BucketId", "b2AccountId", "b2Endpoint", "initDeadlineMinutes", "databaseDsnSecretName", "databaseDsnSecretKey", "cellTokenKeySecretName", "backupMasterKeySecretName", "b2KeyManagementSecretName", "hetznerReadTokenSecretName", "databaseEgressCidrs", "cellResources", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "cellImageRepository": {"type": "string"},
        "namespace": {"const": "exomem-cloud"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 1},
        "b2BucketName": {"type": "string"},
        "b2BucketId": {"type": "string"},
        "b2AccountId": {"type": "string"},
        "b2Endpoint": {"type": "string"},
        "initDeadlineMinutes": {"type": "integer", "minimum": 1},
        "databaseDsnSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseDsnSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "cellTokenKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "backupMasterKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "b2KeyManagementSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "hetznerReadTokenSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseEgressCidrs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"}
        },
        "cellResources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuRequest", "cpuLimit", "memoryRequest", "memoryLimit"],
          "properties": {
            "cpuRequest": {"type": "string"},
            "cpuLimit": {"type": "string"},
            "memoryRequest": {"type": "string"},
            "memoryLimit": {"type": "string"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"type": "object"},
            "limits": {"type": "object"}
          }
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "image": {"pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"},
        "cellImageRepository": {"pattern": "^[^\\s@]+$"},
        "b2BucketName": {"minLength": 1},
        "b2BucketId": {"minLength": 1},
        "b2AccountId": {"minLength": 1},
        "b2Endpoint": {"minLength": 1},
        "databaseEgressCidrs": {"minItems": 1}
      }}
    },
    "cloudGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "replicas", "hostname", "publicBaseUrl", "mcpPath", "cellProtocolVersion", "databaseSecretName", "databaseSecretKey", "controlPlaneKeySecretName", "controlPlaneKeySecretKey", "cellTokenKeySecretName", "trustedIngressSourceHeader", "trustedIngressSourceValue", "databaseEgressCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2},
        "hostname": {"type": "string"},
        "publicBaseUrl": {"type": "string"},
        "mcpPath": {"type": "string", "pattern": "^/[A-Za-z0-9/_-]*$"},
        "cellProtocolVersion": {"type": "string", "pattern": "^[0-9]+$"},
        "controlPlaneKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "controlPlaneKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "trustedIngressSourceHeader": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "trustedIngressSourceValue": {"type": "string"},
        "databaseSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "cellTokenKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseEgressCidrs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "image": {"pattern": "^ghcr\\.io/substrate-systems/substrate-gateway@sha256:[a-f0-9]{64}$"},
        "hostname": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "publicBaseUrl": {"pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "trustedIngressSourceValue": {"pattern": "^[A-Za-z0-9_-]{32,128}$"},
        "databaseEgressCidrs": {"minItems": 1}
      }}
    },
    "cloudStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "encryptionSecretName", "encryptionSecretNamespace"],
      "properties": {
        "className": {"const": "exomem-cloud-encrypted"},
        "encryptionSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "encryptionSecretNamespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "cloudIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hostname", "acmeEmail", "cloudflareApiTokenSecretName", "cloudflareApiTokenSecretKey"],
      "properties": {
        "enabled": {"type": "boolean"},
        "hostname": {"type": "string"},
        "acmeEmail": {"type": "string"},
        "cloudflareApiTokenSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "cloudflareApiTokenSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "hostname": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "acmeEmail": {"pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}
      }}
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csiDriver", "headroom"],
      "properties": {
        "csiDriver": {"type": "string", "minLength": 1},
        "headroom": {"type": "integer", "minimum": 0},
        "attachmentsLimitFallback": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backupWindow", "backupConcurrency", "jobEgressExcept"],
      "properties": {
        "backupWindow": {
          "type": "string", "pattern": "^([01]?[0-9]|2[0-3])-([01]?[0-9]|2[0-3])$",
          "not": {"pattern": "^(?:0?0-0?0|0?1-0?1|0?2-0?2|0?3-0?3|0?4-0?4|0?5-0?5|0?6-0?6|0?7-0?7|0?8-0?8|0?9-0?9|10-10|11-11|12-12|13-13|14-14|15-15|16-16|17-17|18-18|19-19|20-20|21-21|22-22|23-23)$"}
        },
        "backupConcurrency": {"type": "integer", "minimum": 1},
        "jobEgressExcept": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[1-2][0-9]|3[0-2])$"}
        }
      }
    }
  }
}
