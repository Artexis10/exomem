{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["platformJobs", "scheduler", "observability"],
  "$defs": {
    "mediaEngineName": {"enum": ["documents", "ocr", "speech"]}
  },
  "allOf": [
    {"if": {"required": ["memoryHealth"], "properties": {"memoryHealth": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}}, "then": {"properties": {"cloudGateway": {"properties": {"image": {"$ref": "#/properties/cloudGateway/then/properties/image"}, "databaseEgressCidrs": {"minItems": 1}}}}}},
    {"if": {"required": ["cellctl"], "properties": {"cellctl": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}}, "then": {"required": ["cellData"], "properties": {"cellData": {"properties": {"backupBucketName": {"minLength": 1}, "backupBucketId": {"minLength": 1}, "stagingBucketName": {"minLength": 1}, "endpoint": {"minLength": 1}}}}}},
    {"if": {"required": ["keyCustodian"], "properties": {"keyCustodian": {"required": ["enabled"], "properties": {"enabled": {"const": true}}}}}, "then": {"required": ["cellData"], "properties": {"cellData": {"properties": {"backupBucketName": {"minLength": 1}, "backupBucketId": {"minLength": 1}}}, "cellctl": {"properties": {"image": {"pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"}}}}}}
  ],
  "properties": {
    "runtime": false,
    "platformJobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {"type": "string", "pattern": "^ghcr\\.io/artexis10/exomem@sha256:[0-9a-f]{64}$"}
      }
    },
    "scheduler": {
      "type": "object",
      "required": ["contractVersion", "contractSha256", "secretName", "secretKey", "jobs"],
      "properties": {
        "contractVersion": {"const": 1},
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "secretKey": {"type": "string", "minLength": 1},
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exomem-access-delivery", "exomem-reconcile"],
          "properties": {
            "exomem-access-delivery": {
              "type": "object",
              "additionalProperties": false,
              "required": ["servesCloud"],
              "properties": {"servesCloud": {"const": true}, "enabled": {"type": "boolean"}}
            },
            "exomem-reconcile": {
              "type": "object",
              "additionalProperties": false,
              "required": ["servesCloud"],
              "properties": {"servesCloud": {"const": true}, "enabled": {"type": "boolean"}}
            },
            "exomem-health-control": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "servesCloud"],
              "properties": {"servesCloud": {"const": true}, "enabled": {"type": "boolean"}}
            },
            "exomem-health-email": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "servesCloud"],
              "properties": {"servesCloud": {"const": true}, "enabled": {"type": "boolean"}}
            }
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": ["contractSha256", "alertDeliverySecretName", "alertDeliverySecretKey"],
      "properties": {
        "contractSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "alertDeliverySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "alertDeliverySecretKey": {"type": "string", "minLength": 1}
      }
    },
    "cellctl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "cellImageRepository", "namespace", "replicas", "b2BucketName", "b2BucketId", "b2Endpoint", "initDeadlineMinutes", "upgradeReadyDeadlineMinutes", "exportDeadlineMinutes", "exportTtlHours", "databaseDsnSecretName", "databaseDsnSecretKey", "cellTokenKeySecretName", "backupMasterKeySecretName", "cellDataStagingSecretName", "cellDataBackupListSecretName", "hetznerReadTokenSecretName", "databaseEgressCidrs", "cellResources", "resources"],
      "properties": {
        "keyRetentionSources": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "source", "retention_seconds", "observed_at"],
            "properties": {
              "kind": {"enum": ["control_database", "cluster_datastore", "object_versions"]},
              "source": {"type": "string", "minLength": 1},
              "retention_seconds": {"type": ["integer", "null"], "minimum": 0},
              "observed_at": {"type": ["string", "null"]}
            }
          }
        },
        "sharedWorker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "selected",
                "all-shared"
              ]
            },
            "cell_ids": {
              "type": "array",
              "maxItems": 1024,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z2-7]{16}$"
              }
            },
            "profile": {
              "type": "string",
              "maxLength": 63,
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            },
            "topology_key": {
              "type": "string",
              "pattern": "^(?:[a-z0-9.-]+/)?[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$",
              "not": {
                "pattern": "^exomem.io/"
              }
            },
            "topology_value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
            },
            "occupancy": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cpu_request",
                "cpu_limit",
                "memory_request",
                "memory_limit"
              ],
              "properties": {
                "cpu_request": {
                  "type": "string",
                  "minLength": 1
                },
                "memory_request": {
                  "type": "string",
                  "minLength": 1
                },
                "cpu_limit": {
                  "const": "2"
                },
                "memory_limit": {
                  "const": "3Gi"
                }
              }
            },
            "reserve_cpu": {
              "type": "string",
              "minLength": 1
            },
            "reserve_memory": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "off"
              }
            }
          },
          "then": {
            "maxProperties": 1
          },
          "else": {
            "required": [
              "mode",
              "cell_ids",
              "profile",
              "topology_key",
              "topology_value",
              "occupancy",
              "resources",
              "reserve_cpu",
              "reserve_memory"
            ]
          }
        },
        "dedicatedCellIds": {
          "type": "array", "maxItems": 1024, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}
        },
        "mediaEngineCellIds": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/mediaEngineName"},
          "additionalProperties": {
            "type": "array", "maxItems": 1024, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}
          }
        },
        "mediaEngineFleetDefault": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/mediaEngineName"}
        },
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "cellImageRepository": {"type": "string"},
        "namespace": {"const": "exomem-cloud"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 1},
        "b2BucketName": {"type": "string"},
        "b2BucketId": {"type": "string"},
        "b2Endpoint": {"type": "string"},
        "initDeadlineMinutes": {"type": "integer", "minimum": 1},
        "upgradeReadyDeadlineMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120,
          "description": "Minutes cellctl waits for an upgraded cell to become ready before it restores the pre-upgrade snapshot and pauses the rollout. Below 5, a normal first start (image pull, migration, catalogue rebuild) misses it and rolls back a healthy image. Above 120, a broken image keeps the canary cell down for hours before the automatic restore."
        },
        "exportDeadlineMinutes": {"type": "integer", "minimum": 1},
        "exportTtlHours": {"type": "integer", "minimum": 1},
        "databaseDsnSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseDsnSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "cellTokenKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "backupMasterKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "cellDataStagingSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "cellDataBackupListSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "hetznerReadTokenSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "databaseEgressCidrs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"}
        },
        "cellResources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpuRequest", "cpuLimit", "memoryRequest", "memoryLimit"],
          "properties": {
            "cpuRequest": {"type": "string"},
            "cpuLimit": {"type": "string"},
            "memoryRequest": {"type": "string"},
            "memoryLimit": {"type": "string"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"type": "object"},
            "limits": {"type": "object"}
          }
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "image": {"pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"},
        "cellImageRepository": {"pattern": "^[^\\s@]+$"},
        "b2BucketName": {"minLength": 1},
        "b2BucketId": {"minLength": 1},
        "b2Endpoint": {"minLength": 1},
        "databaseEgressCidrs": {"minItems": 1}
      }}
    },
    "cellData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backupBucketName", "backupBucketId", "stagingBucketName", "endpoint"],
      "properties": {
        "backupBucketName": {"type": "string"},
        "backupBucketId": {"type": "string"},
        "stagingBucketName": {"type": "string"},
        "endpoint": {"type": "string", "pattern": "^(|https?://[^\\s]+)$"}
      }
    },
    "keyCustodian": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "namespace", "secretName", "nodeSelector", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"const": "exomem-key-custody"},
        "secretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
          "properties": {"requests": {"type": "object"}, "limits": {"type": "object"}}
        }
      }
    },
    "artifactBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "endpoint", "cellIds", "allCells", "publicKeySecretName", "publicKeySecretKey", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "endpoint": {"type": "string", "pattern": "^(?:|http://(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])):8767/?)$"},
        "cellIds": {"type": "array", "uniqueItems": true, "maxItems": 1024, "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}},
        "allCells": {"type": "boolean"},
        "publicKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "publicKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
          "properties": {"requests": {"type": "object"}, "limits": {"type": "object"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"image": {"pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"}}}},
        {"if": {"properties": {"cellIds": {"minItems": 1}}}, "then": {"properties": {"enabled": {"const": true}, "endpoint": {"minLength": 1}}}},
        {"if": {"properties": {"allCells": {"const": true}}}, "then": {"properties": {"enabled": {"const": true}, "endpoint": {"minLength": 1}}}}
      ]
    },
    "mediaEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "endpoint", "cellIds", "allCells", "credentialEpochs", "maxObjectBytes", "storePolicy", "bucket", "b2SecretName", "signingKeySecretName", "signingKeySecretKey", "publicKeySecretName", "publicKeySecretKey", "state", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "pattern": "^(?:|http://(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])):8769/?)$"},
        "cellIds": {"type": "array", "uniqueItems": true, "maxItems": 1024, "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}},
        "allCells": {"type": "boolean"},
        "credentialEpochs": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z2-7]{16}$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "maxObjectBytes": {"type": "integer", "minimum": 1},
        "storePolicy": {
          "type": "object",
          "properties": {
            "allowance_bytes": {"type": "integer", "minimum": 0},
            "max_temporary_bytes": {"type": "integer", "minimum": 1},
            "max_hydrations": {"type": "integer", "minimum": 1}
          },
          "allOf": [
            {"if": {"required": ["max_temporary_bytes"]}, "then": {"required": ["max_hydrations"]}},
            {"if": {"required": ["max_hydrations"]}, "then": {"required": ["max_temporary_bytes"]}}
          ],
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"type": ["boolean", "number"]}
        },
        "bucket": {"type": "string"},
        "b2SecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "signingKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "signingKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "publicKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "publicKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "state": {
          "type": "object", "additionalProperties": false, "required": ["size", "storageClassName"],
          "properties": {"size": {"type": "string", "pattern": "^[1-9][0-9]*(Gi|Ti)$"}, "storageClassName": {"type": "string"}}
        },
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
          "properties": {"requests": {"type": "object"}, "limits": {"type": "object"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"endpoint": {"minLength": 1}, "bucket": {"minLength": 1}}}},
        {"if": {"properties": {"cellIds": {"minItems": 1}}}, "then": {"properties": {"enabled": {"const": true}}}},
        {"if": {"properties": {"allCells": {"const": true}}}, "then": {"properties": {"enabled": {"const": true}}}}
      ]
    },
    "mediaSlotLease": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "endpoint", "cellIds", "allCells", "poolMiB", "queueSeconds", "maxJobSeconds", "leaseMarginSeconds", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "endpoint": {"type": "string", "pattern": "^(?:|http://(?:10\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(?:1[6-9]|2[0-9]|3[01])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])):8768/?)$"},
        "cellIds": {"type": "array", "uniqueItems": true, "maxItems": 1024, "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}},
        "allCells": {"type": "boolean"},
        "poolMiB": {"type": "integer", "minimum": 1},
        "queueSeconds": {"type": "integer", "minimum": 30},
        "maxJobSeconds": {"type": "integer", "minimum": 1},
        "leaseMarginSeconds": {"type": "integer", "minimum": 15},
        "resources": {
          "type": "object", "additionalProperties": false, "required": ["requests", "limits"],
          "properties": {"requests": {"type": "object"}, "limits": {"type": "object"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"image": {"pattern": "^[^\\s]+@sha256:[a-f0-9]{64}$"}}}},
        {"if": {"properties": {"cellIds": {"minItems": 1}}}, "then": {"properties": {"enabled": {"const": true}, "endpoint": {"minLength": 1}}}},
        {"if": {"properties": {"allCells": {"const": true}}}, "then": {"properties": {"enabled": {"const": true}, "endpoint": {"minLength": 1}}}}
      ]
    },
    "cloudGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "marketplaceReviewerAccessEnabled", "image", "replicas", "hostname", "publicBaseUrl", "mcpPath", "cellProtocolVersion", "databaseSecretName", "databaseSecretKey", "controlPlaneKeySecretName", "controlPlaneKeySecretKey", "cellTokenKeySecretName", "trustedIngressSourceHeader", "trustedIngressSourceValue", "databaseEgressCidrs"],
      "properties": {
        "enabled": {"type": "boolean"},
        "marketplaceReviewerAccessEnabled": {"type": "boolean"},
        "artifactTransportEnabled": {"type": "boolean"},
        "transferTools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        },
        "uploadCellIds": {"type": "array", "uniqueItems": true, "maxItems": 1024, "items": {"type": "string", "pattern": "^[a-z2-7]{16}$"}},
        "artifactSigningKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "artifactSigningKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "image": {"type": "string"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 2},
        "hostname": {"type": "string"},
        "publicBaseUrl": {"type": "string"},
        "mcpPath": {"type": "string", "pattern": "^/[A-Za-z0-9/_-]*$"},
        "cellProtocolVersion": {"type": "string", "pattern": "^[0-9]+$"},
        "controlPlaneKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "controlPlaneKeySecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "trustedIngressSourceHeader": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "trustedIngressSourceValue": {"type": "string"},
        "databaseSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "databaseSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "cellTokenKeySecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "databaseEgressCidrs": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"}
        }
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "image": {"pattern": "^ghcr\\.io/substrate-systems/substrate-gateway@sha256:[a-f0-9]{64}$"},
        "hostname": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "publicBaseUrl": {"pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "trustedIngressSourceValue": {"pattern": "^[A-Za-z0-9_-]{32,128}$"},
        "databaseEgressCidrs": {"minItems": 1}
      }}
    },
    "cloudStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "encryptionSecretName", "encryptionSecretNamespace"],
      "properties": {
        "className": {"const": "exomem-cloud-encrypted"},
        "perCellClassName": {"type": "string", "minLength": 1, "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$", "not": {"const": "exomem-cloud-encrypted"}},
        "encryptionSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "encryptionSecretNamespace": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "cellStorage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "local", "arrayExporter", "snapshotController"],
      "properties": {
        "domain": {"enum": ["hetzner", "local", "per-cell"]},
        "maxCellGib": {"type": ["integer", "null"], "minimum": 4},
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "backupConcurrencyPerNode", "maxCellGib"],
          "properties": {
            "enabled": {"type": "boolean"},
            "reservations": {"type": "boolean"},
            "reservationNamespace": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
            "backupConcurrencyPerNode": {"type": "integer", "minimum": 1},
            "maxCellGib": {"type": ["integer", "null"], "minimum": 4}
          }
        },
        "arrayExporter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {"type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"}
          }
        },
        "snapshotController": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": {"type": "string", "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "topolvm": {
      "type": "object",
      "required": ["fullnameOverride"],
      "properties": {
        "fullnameOverride": {"type": "string", "minLength": 1},
        "lvmd": {
          "type": "object",
          "properties": {
            "deviceClasses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "thin-pool": {
                    "type": "object",
                    "required": ["overprovision-ratio"],
                    "properties": {"overprovision-ratio": {"const": 1.0}}
                  }
                }
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiServerCidrs"],
      "properties": {
        "apiServerCidrs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "memoryHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "cellId", "databaseSecretName", "databaseSecretKey", "bearerSecretName", "bearerSecretKey", "page", "bodyTemplate", "timeoutMs", "activeDeadlineSeconds"],
      "properties": {
        "enabled": {"type": "boolean"},
        "cellId": {"type": "string"},
        "databaseSecretName": {"type": "string"},
        "databaseSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "bearerSecretName": {"type": "string"},
        "bearerSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "page": {"type": "string"},
        "bodyTemplate": {"type": "string", "maxLength": 32000},
        "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 20000},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1, "maximum": 30}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"cellId": {"pattern": "^[a-z2-7]{16}$", "$comment": "Cloud cell IDs follow the fixed 16-character base32 protocol."}, "databaseSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "bearerSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}, "page": {"minLength": 1}, "bodyTemplate": {"pattern": "\\{\\{nonce\\}\\}", "$comment": "The synthetic runner requires the fixed {{nonce}} protocol placeholder."}}}
    },
    "cloudIngress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hostname", "acmeEmail", "cloudflareApiTokenSecretName", "cloudflareApiTokenSecretKey"],
      "properties": {
        "enabled": {"type": "boolean"},
        "functionalHealthEnabled": {"type": "boolean"},
        "hostname": {"type": "string"},
        "acmeEmail": {"type": "string"},
        "cloudflareApiTokenSecretName": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "cloudflareApiTokenSecretKey": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {
        "hostname": {"pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}\\.)+[a-z]{2,63}$"},
        "acmeEmail": {"pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"}
      }}
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["csiDriver", "headroom"],
      "properties": {
        "csiDriver": {"type": "string", "minLength": 1},
        "headroom": {"type": "integer", "minimum": 0},
        "attachmentsLimitFallback": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backupWindow", "backupConcurrency", "jobEgressExcept"],
      "properties": {
        "backupWindow": {
          "type": "string", "pattern": "^([01]?[0-9]|2[0-3])-([01]?[0-9]|2[0-3])$",
          "not": {"pattern": "^(?:0?0-0?0|0?1-0?1|0?2-0?2|0?3-0?3|0?4-0?4|0?5-0?5|0?6-0?6|0?7-0?7|0?8-0?8|0?9-0?9|10-10|11-11|12-12|13-13|14-14|15-15|16-16|17-17|18-18|19-19|20-20|21-21|22-22|23-23)$"}
        },
        "backupConcurrency": {"type": "integer", "minimum": 1},
        "jobEgressExcept": {
          "type": "array", "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[1-2][0-9]|3[0-2])$"}
        }
      }
    }
  }
}
