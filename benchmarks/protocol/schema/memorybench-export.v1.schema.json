          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "root",
        "path",
        "path_hmac_sha256",
        "sha256"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
