    "ArtifactReference": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "path": {
                "type": "null"
              },
              "path_hmac_sha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          },
          "if": {
            "properties": {
              "root": {
                "const": "output"
              }
            },
            "required": [
              "root"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "minLength": 1,
                "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$",
                "type": "string"
              },
              "path_hmac_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "path_hmac_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path Hmac Sha256"
        },
        "root": {
          "enum": [
            "memorybench_run",
            "output"
          ],
