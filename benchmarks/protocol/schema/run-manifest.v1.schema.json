{
  "$defs": {
    "DatasetIdentity": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "variant": {
          "title": "Variant",
          "type": "string"
        }
      },
      "required": [
        "id",
        "variant",
        "source",
        "revision",
        "sha256",
        "case_count"
      ],
      "title": "DatasetIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "$ref": "#/$defs/DatasetIdentity"
    },
    "finalized_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finalized At"
    },
    "namespaces": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Namespaces",
      "type": "object"
    },
    "pins": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Pins",
      "type": "object"
    },
    "protocol_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "dataset",
    "status",
    "started_at"
  ],
  "title": "RunManifest",
  "type": "object"
}
