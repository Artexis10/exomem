{
  "schema_version": 1,
  "family": "governed-curation",
  "command": "maintain_memory",
  "selector": {
    "name": "mode",
    "value": "curation"
  },
  "actions": [
    "work-item",
    "propose",
    "preview",
    "status",
    "apply",
    "resume",
    "propose-compensation",
    "apply-compensation"
  ],
  "read_only_actions": [
    "work-item",
    "preview",
    "status"
  ],
  "action_authority": {
    "work-item": "structural_suggestions",
    "propose": "structural_suggestions",
    "preview": "structural_suggestions",
    "status": "structural_suggestions",
    "propose-compensation": "structural_suggestions",
    "apply": "restructure_execution",
    "resume": "restructure_execution",
    "apply-compensation": "restructure_execution"
  },
  "confirmation_required_actions": [
    "apply",
    "apply-compensation"
  ],
  "approved_plan_resume_actions": [
    "resume"
  ],
  "cases": [
    {
      "id": "explicit-work-item-read",
      "arguments": {
        "mode": "curation",
        "curation_action": "work-item",
        "paths": [
          "Knowledge Base/Notes/Insights/compiled-example.md"
        ]
      },
      "classification": "read_only",
      "admission": "allow"
    },
    {
      "id": "sealed-plan-preview",
      "arguments": {
        "mode": "curation",
        "curation_action": "preview",
        "run_id": "cur-20300101-111111111111"
      },
      "classification": "read_only",
      "admission": "allow"
    },
    {
      "id": "agent-authored-plan-proposal",
      "arguments": {
        "mode": "curation",
        "curation_action": "propose",
        "plan": {
          "version": 1,
          "title": "Synthetic curation plan",
          "steps": [
            {
              "step_id": "synthetic-note",
              "kind": "create-note",
              "args": {
                "title": "Synthetic conclusion",
                "content": "Synthetic durable content."
              }
            }
          ]
        }
      },
      "classification": "structural_suggestions",
      "admission": "allow"
    },
    {
      "id": "reviewed-one-step-apply",
      "arguments": {
        "mode": "curation",
        "curation_action": "apply",
        "run_id": "cur-20300101-111111111111",
        "plan_id": "1111111111111111111111111111111111111111111111111111111111111111",
        "expected_plan_fingerprint": "2222222222222222222222222222222222222222222222222222222222222222",
        "why": "Apply the exact reviewed synthetic plan."
      },
      "classification": "restructure_execution",
      "admission": "confirm_required",
      "maximum_content_steps": 1
    },
    {
      "id": "approved-plan-resume",
      "arguments": {
        "mode": "curation",
        "curation_action": "resume",
        "run_id": "cur-20300101-111111111111",
        "plan_id": "1111111111111111111111111111111111111111111111111111111111111111"
      },
      "classification": "restructure_execution",
      "admission": "approved_plan_only",
      "fresh_confirmation_required": false,
      "maximum_content_steps": 1
    },
    {
      "id": "compensation-plan-proposal",
      "arguments": {
        "mode": "curation",
        "curation_action": "propose-compensation",
        "run_id": "cur-20300101-111111111111"
      },
      "classification": "structural_suggestions",
      "admission": "allow"
    },
    {
      "id": "unknown-action-fails-closed",
      "arguments": {
        "mode": "curation",
        "curation_action": "future-action"
      },
      "classification": "restructure_execution",
      "admission": "refuse"
    },
    {
      "id": "omitted-action-fails-closed",
      "arguments": {
        "mode": "curation"
      },
      "classification": "restructure_execution",
      "admission": "refuse"
    }
  ],
  "compatibility": {
    "hosted_v1_v4": "frozen-neither-advertise-nor-admit",
    "hosted_v5": "candidate-owner-composes-this-contribution"
  }
}
