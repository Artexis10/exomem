  "query_plan_items": {
    "description": "Read the person's Planning. Without `collection`, list the plan collections; with one, filter its items.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string",
          "description": "Omit to list plan collections."
        },
        "filters": {
          "items": {
            "properties": {
              "column": {
                "description": "Column or dotted path.",
                "type": "string"
              },
              "op": {
                "default": "eq",
                "enum": [
                  "contains",
                  "eq",
                  "exists",
                  "gt",
                  "gte",
                  "icontains",
                  "in",
                  "lt",
                  "lte",
                  "missing",
                  "ne",
                  "nin",
                  "startswith"
                ],
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "column"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sort_by": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer"
        },
        "more": {
          "type": "string",
          "description": "Continuation token."
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: lifecycle, hierarchy_mode, aggregate, view, output_format."
        }
      },
      "type": "object"
    }
  },
  "query_records": {
    "description": "Read the person's Records. Without `collection`, list the collections and their fields; with one, filter and sort its rows.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string",
          "description": "Omit to list collections."
        },
        "filters": {
          "items": {
            "properties": {
              "column": {
                "description": "Column or dotted path.",
                "type": "string"
              },
              "op": {
                "default": "eq",
                "enum": [
                  "contains",
                  "eq",
                  "exists",
                  "gt",
                  "gte",
                  "icontains",
                  "in",
                  "lt",
                  "lte",
                  "missing",
                  "ne",
                  "nin",
                  "startswith"
                ],
                "type": "string"
              },
              "value": {}
            },
            "required": [
              "column"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Columns to return; every row keeps its `id`."
        },
        "sort_by": {
          "type": "string"
        },
        "descending": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer"
        },
        "more": {
          "type": "string",
          "description": "Continuation token."
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: aggregate, date_from, date_to, view, output_format."
        }
      },
      "type": "object"
    }
  },
  "read_instructions": {
    "description": "Read the live memory policy, or the arguments and one example of a tool, a door or one door operation.",
    "inputSchema": {
      "properties": {
        "topic": {
          "type": "string",
          "description": "A tool, a door or a door operation such as schema.save."
        },
        "profile": {
          "type": "string",
          "description": "compact (default), full, diagnostics or session."
        },
        "section": {
          "type": "string",
          "description": "One block of the compact policy; `index` lists them."
        },
        "skill_contract": {
          "type": "string",
          "description": "Session digest of the installed skill."
        }
      },
      "type": "object"
    }
  },
  "read_page": {
    "description": "Read one page by title or id: text, type, date and links.",
    "inputSchema": {
      "properties": {
        "page": {
          "description": "Page title or id.",
          "type": "string"
        },
        "part": {
          "enum": [
            "text",
            "history",
            "units"
          ],
          "type": "string",
          "description": "text (default), history, or units: observations with their ids."
        },
        "more": {
          "type": "string",
          "description": "Continuation token."
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: links, frontmatter_only, include_raw, unit_ref, offset."
        }
      },
      "required": [
        "page"
      ],
      "type": "object"
    }
  },
  "recall_context": {
    "description": "Recall authorized context; abstain if uncertain.\n\nReuse held context; conversation gives excerpts. Agent focus is not human intent.\nKeep identity/scope; clarify ambiguity. Due/refresh grants no writes.\nRead map/task_context refs and method scope/exclusions with a page read.\nDiscard held methods on methods.reset. Follow next_action.\nepistemic_status: counts/completeness; a page read: provenance.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "turn": {
          "default": "",
          "description": "Human turn verbatim; never a summary. Empty abstains.",
          "type": "string"
        },
        "max_chars": {
          "default": 4000,
          "description": "Prose cap clamped to 500..8,000; overflow becomes pointers.",
          "type": "integer"
        },
        "purpose": {
          "type": "string",
          "description": "Visibility; never ranking."
        },
        "continuity": {
          "type": "string",
          "description": "Prior token unchanged; drop on compaction/new session."
        },
        "anchor": {
          "type": "string",
          "description": "Visible compiled ref for an established prior subject, ambiguity or correction."
        },
        "include_timings": {
          "default": false,
          "type": "boolean"
        },
        "client": {
          "type": "string",
          "description": "Lowercase client label; invalid labels ignored."
        },
        "session": {
          "type": "string",
          "description": "Stable opaque conversation ID; max 256 chars."
        },
        "workspace": {
          "type": "string",
          "description": "Thread project key; max 256 chars."
        },
        "conversation": {
          "additionalProperties": false,
          "properties": {
            "focus": {
              "description": "Assistant-authored subject cue; separate from user words.",
              "maxLength": 240,
              "type": "string"
            },
            "recent": {
              "description": "Relevant excerpts, newest last; 2,400 characters total.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "role": {
                    "enum": [
                      "user",
                      "assistant"
                    ],
                    "type": "string"
                  },
                  "text": {
                    "description": "Max 600 user or 300 assistant characters.",
                    "maxLength": 600,
                    "type": "string"
                  }
                },
                "required": [
                  "role",
                  "text"
                ],
                "type": "object"
              },
              "maxItems": 6,
              "type": "array"
            },
            "refs": {
              "description": "Canonical page references already read.",
              "items": {
                "maxLength": 1024,
                "type": "string"
              },
              "maxItems": 12,
              "type": "array"
            }
          },
          "type": "object",
          "description": "Relevant excerpts and refs; never full history."
        },
        "trigger": {
          "default": "user_turn",
          "description": "user_turn: initial recall. task_refresh: keep turn; task in focus.",
          "enum": [
            "user_turn",
            "task_refresh"
          ],
          "type": "string"
        },
        "initiator": {
          "type": "string",
          "description": "Caller label; no authority. Invalid labels ignored."
        }
      },
      "type": "object"
    }
  },
  "save_episode": {
    "description": "Save a recap of this session: what was worked on, decided and left open. Call once at a stopping point when policy allows.",
    "inputSchema": {
      "properties": {
        "summary": {
          "description": "One line, at most 180 characters.",
          "type": "string"
        },
        "episode": {
          "type": "string",
          "description": "The `ep-` key a previous save returned; omit on the first save."
        },
        "subject": {
          "type": "string"
        },
        "worked_on": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "decided": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "open": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "What was left open."
        },
        "said": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Up to three verbatim user statements."
        },
        "about": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Pages this concerns, by title."
        },
        "client": {
          "type": "string"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "type": "object"
    }
  },
  "save_evidence": {
    "description": "Keep proof as append-only evidence: text with a name, or attached files.",
    "inputSchema": {
      "properties": {
        "scope": {
          "description": "Case or project key, one path segment.",
          "type": "string"
        },
        "category": {
          "description": "One path segment.",
          "type": "string"
        },
        "name": {
          "type": "string",
          "description": "File name with extension, for `text`."
        },
        "text": {
          "type": "string",
          "description": "Exact UTF-8 text to keep."
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "download_url": {
                "type": "string"
              },
              "file_id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "mime_type": {
                "maxLength": 255,
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            },
            "required": [
              "download_url",
              "file_id"
            ],
            "type": "object"
          },
          "type": "array",
          "description": "Attached files, up to eight."
        },
        "description": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: raw_protection, transcriptions, archive."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "scope",
        "category"
      ],
      "type": "object"
    }
  },
  "save_source": {
    "description": "Save original material verbatim. Never retype a file: pass attached files in `files`.",
    "inputSchema": {
      "properties": {
        "title": {
          "type": "string"
        },
        "source_kind": {
          "type": "string",
          "description": "What the material is, as an open slug such as contract."
        },
        "content": {
          "type": "string",
          "description": "The original text; attached files go in `files`."
        },
        "url": {
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "download_url": {
                "type": "string"
              },
              "file_id": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "mime_type": {
                "maxLength": 255,
                "type": "string"
              },
              "file_name": {
                "type": "string"
              }
            },
            "required": [
              "download_url",
              "file_id"
            ],
            "type": "object"
          },
          "type": "array",
          "description": "Attached files, up to eight."
        },
        "domain": {
          "type": "string"
        },
        "projects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "why": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: raw_protection, source_identity, expected_sha256, correction."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    }
  },
  "search_memory": {
    "description": "Search notes, sources and evidence for what recall_context missed. Hits are named by title; open one with read_page. A miss covers this query only.",
    "inputSchema": {
      "properties": {
        "query": {
          "type": "string",
          "description": "What to look for. Empty lists recent pages."
        },
        "types": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "projects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "filters": {
          "type": "object",
          "description": "Metadata filter, such as {\"page.status\": \"active\"}."
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: mode, rerank, scope, relations, categories, kinds."
        },
        "deep": {
          "type": "boolean",
          "description": "Return a packed context for reasoning."
        },
        "limit": {
          "type": "integer"
        },
        "more": {
          "type": "string",
          "description": "Continuation token."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "supersede_note": {
    "description": "Replace a note whose conclusion changed. The old note stays readable and points to the new one.",
    "inputSchema": {
      "properties": {
        "note": {
          "description": "The note to replace.",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "project": {
          "type": "string"
        },
        "projects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "type": "object"
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Why this links to no other page."
        },
        "vocabulary_decision": {
          "additionalProperties": false,
          "description": "The answer to a vocabulary_preparation.",
          "properties": {
            "evidence_fingerprint": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "reuse",
                "create",
                "defer"
              ],
              "type": "string"
            },
            "canonical": {
              "type": "string",
              "description": "The value to use; none for defer."
            }
          },
          "required": [
            "evidence_fingerprint",
            "outcome"
          ],
          "type": "object"
        },
        "preview": {
          "type": "boolean"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "note",
        "title",
        "content",
        "why"
      ],
      "type": "object"
    }
  },
  "upload_files": {
    "description": "Get a one-use upload for bytes on this machine. The reply gives the step that moves them; then pass the handle to save_source or save_evidence.",
    "inputSchema": {
      "properties": {
        "lane": {
          "description": "Where the bytes go: source (original), evidence (proof) or import (folder archive; not Cloud).",
          "enum": [
            "source",
            "evidence",
            "import"
          ],
          "type": "string"
        },
        "expected_sha256": {
          "type": "string",
          "description": "SHA-256 of the file you intend to send."
        },
        "hold": {
          "type": "boolean",
          "description": "Keep the upload for this session; needs expected_sha256."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "lane"
      ],
      "type": "object"
    }
  }
}
