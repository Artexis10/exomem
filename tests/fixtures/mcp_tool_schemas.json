      "properties": {
        "queue": {
          "enum": [
            "due",
            "activation",
            "stale",
            "contradiction",
            "unprocessed_sources",
            "unlinked",
            "relation_suggestions",
            "imports",
            "upkeep",
            "plan_progress",
            "vocabulary",
            "procedure_approvals"
          ],
          "type": "string",
          "description": "One queue; due items by default."
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Keep only these finding categories, or upkeep families."
        },
        "limit": {
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
