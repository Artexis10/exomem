{
  "add_observation": {
    "description": "Add one observation to an existing note; nothing existing changes.",
    "inputSchema": {
      "properties": {
        "note": {
          "description": "Page title or id.",
          "type": "string"
        },
        "category": {
          "description": "Observation category, such as decision or finding.",
          "type": "string"
        },
        "text": {
          "description": "The observation, on one line.",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "context": {
          "type": "string"
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "page"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "kind": {
          "type": "string",
          "description": "A rich kind, such as hypothesis; omit for a compact observation."
        },
        "verdict": {
          "type": "string",
          "description": "A rich verdict in words, never a number; see inspect_memory schema.infer."
        },
        "anchor": {
          "type": "string",
          "description": "Unique within the note; derived when omitted."
        },
        "as_of": {
          "type": "string",
          "description": "ISO date this starts to hold."
        },
        "until": {
          "type": "string",
          "description": "ISO date this stops holding."
        },
        "check_by": {
          "type": "string",
          "description": "ISO date to revisit."
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Why this links to no other page."
        },
        "preview": {
          "type": "boolean"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "note",
        "category",
        "text"
      ],
      "type": "object"
    }
  },
  "add_plan_item": {
    "description": "Add an item to a plan the person owns.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "item": {
          "description": "Fields by column name.",
          "type": "object"
        },
        "why": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "collection",
        "item",
        "why"
      ],
      "type": "object"
    }
  },
  "add_record": {
    "description": "Add a row to a Records collection the person owns. Outcomes go here; intentions go to Planning.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "item": {
          "description": "Fields by column name.",
          "type": "object"
        },
        "why": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "Free text kept with the row."
        },
        "hold": {
          "type": "boolean",
          "description": "Hold a row that fails validation."
        },
        "held": {
          "type": "string",
          "description": "The id of a held row to resume."
        },
        "options": {
          "type": "object",
          "description": "Rare knobs: delivery, item_key."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "collection",
        "item",
        "why"
      ],
      "type": "object"
    }
  },
  "create_note": {
    "description": "Save a lasting conclusion as a new note. Raw material goes in save_source, proof in save_evidence. Link a page, or give unlinked_reason.",
    "inputSchema": {
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "description": "Markdown body with a `## Observations` section of `- [category] text` lines. Link a page with [[Title]].",
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "description": "The research note's project key; a new slug registers itself."
        },
        "projects": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Project keys of another note; a new slug registers itself."
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Titles of the pages this draws from."
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "type": "object",
          "description": "Type-specific metadata, such as severity or hypothesis."
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Why this links to no other page."
        },
        "vocabulary_decision": {
          "additionalProperties": false,
          "description": "The answer to a vocabulary_preparation.",
          "properties": {
            "evidence_fingerprint": {
              "type": "string"
            },
            "outcome": {
              "enum": [
                "reuse",
                "create",
                "defer"
              ],
              "type": "string"
            },
            "canonical": {
              "type": "string",
              "description": "The value to use; none for defer."
            }
          },
          "required": [
            "evidence_fingerprint",
            "outcome"
          ],
          "type": "object"
        },
        "suggest_links": {
          "type": "boolean",
          "description": "Also return pages to link."
        },
        "preview": {
          "type": "boolean"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "title",
        "content"
      ],
      "type": "object"
    }
  },
  "decide_review_item": {
    "description": "Record the person's decision on one review item. accept applies to a relation suggestion.",
    "inputSchema": {
      "properties": {
        "review_item": {
          "description": "A list_review_items id, or an advisory ref.",
          "type": "string"
        },
        "decision": {
          "enum": [
            "accept",
            "dismiss",
            "snooze",
            "reopen",
            "competing"
          ],
          "type": "string"
        },
        "until": {
          "type": "string",
          "description": "snooze: YYYY-MM-DD."
        },
        "why": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "description": "accept: the relation to record, if several are offered."
        },
        "vocabulary_ref": {
          "type": "string",
          "description": "accept: the vocabulary decision that names a relation the suggestion lacks."
        },
        "vocabulary_fingerprint": {
          "type": "string",
          "description": "accept: that decision's fingerprint."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "review_item",
        "decision"
      ],
      "type": "object"
    }
  },
  "download_files": {
    "description": "Get the original files of pages back out of memory. The reply gives a link or a command that saves each.",
    "inputSchema": {
      "properties": {
        "pages": {
          "description": "Titles or ids of the pages.",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "pages"
      ],
      "type": "object"
    }
  },
  "edit_note": {
    "description": "Change part of an existing note and say why. A changed conclusion goes to supersede_note. `action` picks the change; each action takes its own fields.",
    "inputSchema": {
      "properties": {
        "note": {
          "description": "Page title, or the page id for replace_body.",
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "action": {
          "enum": [
            "replace_text",
            "replace_section",
            "replace_body",
            "set_tags",
            "set_fields",
            "fill_row",
            "edit_observation",
            "remove_observation"
          ],
          "type": "string"
        },
        "old_text": {
          "type": "string",
          "description": "replace_text."
        },
        "new_text": {
          "type": "string",
          "description": "replace_text, replace_section."
        },
        "replace_all": {
          "type": "boolean",
          "description": "replace_text: every match."
        },
        "edits": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "old_text": {
                "type": "string"
              },
              "new_text": {
                "type": "string"
              },
              "replace_all": {
                "type": "boolean"
              }
            },
            "required": [
              "old_text",
              "new_text"
            ],
            "type": "object"
          },
          "type": "array",
          "description": "replace_text: several in one commit."
        },
        "heading": {
          "type": "string",
          "description": "replace_section."
        },
        "position": {
          "enum": [
            "append",
            "prepend",
            "replace"
          ],
          "type": "string",
          "description": "replace_section; append by default."
        },
        "create_missing": {
          "type": "boolean",
          "description": "replace_section: add an absent heading."
        },
        "body": {
          "type": "string",
          "description": "replace_body."
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "set_tags, edit_observation: the full list."
        },
        "fields": {
          "type": "object",
          "description": "set_fields."
        },
        "row": {
          "type": "string",
          "description": "fill_row: the row's leading text."
        },
        "take": {
          "type": "string",
          "description": "fill_row."
        },
        "overwrite": {
          "type": "boolean",
          "description": "fill_row: replace a filled take."
        },
        "observation": {
          "type": "string",
          "description": "edit_observation, remove_observation: the unit id."
        },
        "category": {
          "type": "string",
          "description": "edit_observation."
        },
        "text": {
          "type": "string",
          "description": "edit_observation."
        },
        "context": {
          "type": "string",
          "description": "edit_observation."
        },
        "links": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "relation": {
                "type": "string"
              },
              "page": {
                "type": "string"
              }
            },
            "required": [
              "relation",
              "page"
            ],
            "type": "object"
          },
          "type": "array",
          "description": "edit_observation: the full list."
        },
        "unlinked_reason": {
          "type": "string",
          "description": "Why this links to no other page."
        },
        "preview": {
          "type": "boolean"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "note",
        "why",
        "action"
      ],
      "type": "object"
    }
  },
  "edit_plan_item": {
    "description": "Change one plan item, or move it to a new status with `status`.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "plan_item": {
          "description": "The item id that query_plan_items returned.",
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "changes": {
          "type": "object",
          "description": "Columns to change, by name."
        },
        "status": {
          "type": "string",
          "description": "Move to this status; a refused move names the allowed ones."
        },
        "body": {
          "type": "string"
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "collection",
        "plan_item",
        "why"
      ],
      "type": "object"
    }
  },
  "edit_record": {
    "description": "Change fields of one record.",
    "inputSchema": {
      "properties": {
        "collection": {
          "type": "string"
        },
        "record": {
          "description": "The row `id` from query_records, or `row_id` when the collection has its own `id` field.",
          "type": "string"
        },
        "changes": {
          "description": "Columns to change, by name.",
          "type": "object"
        },
        "why": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "held": {
          "type": "string"
        },
        "refresh_presentation": {
          "type": "boolean",
          "description": "Rebuild the row's Markdown view; `changes` may then be empty."
        },
        "detail": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        }
      },
      "required": [
        "collection",
        "record",
        "changes",
        "why"
      ],
      "type": "object"
    }
  },
