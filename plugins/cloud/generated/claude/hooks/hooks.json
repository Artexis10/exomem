{
  "description": "Canonical Exomem MCP activation, governed capture and local continuation.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exomem_retrieve_nudge.py",
              "--client",
              "claude",
              "--hook-home",
              "${CLAUDE_PLUGIN_DATA}",
              "--activation-mode",
              "mcp"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exomem_capture_nudge.py",
              "--client",
              "claude",
              "--hook-home",
              "${CLAUDE_PLUGIN_DATA}",
              "--activation-mode",
              "mcp"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exomem_continuation_checkpoint.py",
              "--client",
              "claude",
              "--hook-home",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ],
        "matcher": "manual|auto"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exomem_continuation_checkpoint.py",
              "--client",
              "claude",
              "--hook-home",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/exomem_continuation_checkpoint.py",
              "--client",
              "claude",
              "--hook-home",
              "${CLAUDE_PLUGIN_DATA}"
            ],
            "timeout": 5
          }
        ],
        "matcher": "compact|resume"
      }
    ]
  }
}
